# =============================================================================
# Configuração da API. Copie para .env e ajuste — .env nunca é versionado.
# =============================================================================

# Conexão do runtime. O papel PRECISA ser iarx_app: ele é SUJEITO a RLS.
# Conectar como postgres/service_role faria as políticas serem ignoradas e o
# isolamento entre tenants (RN-028) deixaria de existir — sem nenhum sinal.
DATABASE_URL=postgresql://iarx_app:SENHA@127.0.0.1:5432/iarx

# No Supabase, use a porta 6543 (Supavisor, modo transação) e NÃO a 5432:
# DATABASE_URL=postgresql://iarx_app:SENHA@db.PROJETO.supabase.co:6543/postgres

PORT=3000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=8000
DB_IDLE_TX_TIMEOUT_MS=10000

# Fuso da operação, usado só na formatação de datas em mensagens ao usuário.
# Deve migrar para parâmetro do tenant quando o módulo existir.
IARX_FUSO=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Autenticação — escolha UMA das duas formas.
# -----------------------------------------------------------------------------

# PRODUÇÃO: verificação por chave pública. A API não guarda material capaz de
# emitir token.
# IARX_JWKS_URL=https://PROJETO.supabase.co/auth/v1/.well-known/jwks.json
# IARX_JWT_ISSUER=https://PROJETO.supabase.co/auth/v1
# IARX_JWT_AUDIENCE=authenticated

# LOCAL/CI apenas: HS256 com segredo compartilhado. Quem verifica também
# consegue assinar — o bootstrap recusa subir com isto em NODE_ENV=production.
IARX_JWT_SEGREDO=troque-este-segredo-de-desenvolvimento
