{
  "name": "iarx",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestão de locação de equipamentos — monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "a11y:tokens": "node packages/tokens/scripts/validate-contrast.mjs",
    "a11y:relatorio": "node packages/tokens/scripts/validate-contrast.mjs --json",
    "tokens:build": "node packages/tokens/scripts/build-css.mjs",
    "db:migrate": "packages/db/scripts/migrate.sh",
    "db:test": "packages/db/scripts/test.sh",
    "dev": "vite apps/web",
    "build": "node packages/tokens/scripts/build-css.mjs && vite build apps/web",
    "tipos": "tsc -p packages/contracts/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "a11y:dom": "playwright test apps/web",
    "web:test": "npm run contratos:build && node --test \"apps/web/test/*.test.ts\"",
    "verificar": "npm run tipos && npm run a11y:tokens && npm run web:test && npm run build && npm run a11y:dom && npm run db:test && npm run api:test",
    "contratos:build": "tsc -p packages/contracts/tsconfig.json",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node apps/api/dist/main.js",
    "api:test": "apps/api/scripts/testar.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  }
}
